#!/bin/sh
# Personalização do WX OS — roda dentro do sistema durante a compilação.
set -e
echo ">>> [WX OS] aplicando identidade e configurações"

# ---- Identidade (os-release), protegida contra atualizações do Debian ----
if ! dpkg-divert --list /usr/lib/os-release | grep -q wxos; then
  dpkg-divert --local --package wxos --rename --divert /usr/lib/os-release.debian --add /usr/lib/os-release
fi
DEBVER="$(cat /etc/debian_version 2>/dev/null || echo 13)"
cat > /usr/lib/os-release <<OSR
PRETTY_NAME="WX OS 1.0"
NAME="WX OS"
VERSION_ID="1.0"
VERSION="1.0 (base Debian ${DEBVER})"
VERSION_CODENAME=trixie
ID=wxos
ID_LIKE=debian
HOME_URL="https://souzasolucoesdigitais.com.br"
SUPPORT_URL="https://souzasolucoesdigitais.com.br"
BUG_REPORT_URL="https://souzasolucoesdigitais.com.br"
LOGO=wx-os
OSR
ln -sf ../usr/lib/os-release /etc/os-release
echo "WX OS 1.0 \\n \\l" > /etc/issue
echo "WX OS 1.0" > /etc/issue.net

# ---- Idioma, teclado ABNT2 e fuso ----
sed -i 's/^# *pt_BR.UTF-8 UTF-8/pt_BR.UTF-8 UTF-8/' /etc/locale.gen
grep -q '^pt_BR.UTF-8 UTF-8' /etc/locale.gen || echo 'pt_BR.UTF-8 UTF-8' >> /etc/locale.gen
locale-gen
update-locale LANG=pt_BR.UTF-8 LANGUAGE=pt_BR:pt:en
cat > /etc/default/keyboard <<KBD
XKBMODEL="abnt2"
XKBLAYOUT="br"
XKBVARIANT=""
XKBOPTIONS=""
BACKSPACE="guess"
KBD
ln -sf /usr/share/zoneinfo/America/Sao_Paulo /etc/localtime
echo "America/Sao_Paulo" > /etc/timezone

# ---- Instalador Calamares com a marca WX OS ----
if [ -f /etc/calamares/settings.conf ]; then
  sed -i 's/^branding:.*/branding: wxos/' /etc/calamares/settings.conf
fi
for f in /usr/share/applications/install-debian.desktop /usr/share/applications/calamares.desktop; do
  [ -f "$f" ] || continue
  sed -i -e 's/^Name=.*/Name=Instalar o WX OS/' \
         -e 's/^Name\[pt_BR\]=.*/Name[pt_BR]=Instalar o WX OS/' \
         -e 's/^Icon=.*/Icon=\/usr\/share\/pixmaps\/wx-os.png/' "$f"
done

# Instalação do GRUB sem precisar de internet: deixa os pacotes guardados na ISO
# (efi = UEFI com Secure Boot assinado; bios = PCs antigos/Legacy)
baixar_grub() {
  dir="/opt/wxos/grub/$1"; shift
  mkdir -p "$dir/partial"
  apt-get install -y --download-only --no-install-recommends \
    -o Dir::Cache::archives="$dir" "$@" || echo "aviso: não baixou $*"
  rm -rf "$dir/partial" "$dir/lock"
}
baixar_grub efi grub-efi-amd64 grub-efi-amd64-signed shim-signed
baixar_grub bios grub-pc
if [ -x /usr/sbin/bootloader-config ] && ! dpkg-divert --list /usr/sbin/bootloader-config | grep -q wxos; then
  dpkg-divert --local --package wxos --rename --divert /usr/sbin/bootloader-config.debian --add /usr/sbin/bootloader-config
fi
ln -sf /usr/local/sbin/wxos-bootloader-config /usr/sbin/bootloader-config

# ---- Permissões dos scripts do WX OS ----
chmod 755 /usr/local/bin/wxos-* /usr/local/sbin/wxos-*

echo ">>> [WX OS] personalização concluída"
