#!/bin/sh
# Personalização do WX OS — roda dentro do sistema durante a compilação.
set -e
echo ">>> [WX OS] aplicando identidade, interface estilo macOS e configurações"

# ---- Identidade (os-release), protegida contra atualizações do Ubuntu ----
if ! dpkg-divert --list /usr/lib/os-release | grep -q wxos; then
  dpkg-divert --local --package wxos --rename --divert /usr/lib/os-release.ubuntu --add /usr/lib/os-release
fi
UBUVER="$(cat /etc/os-release 2>/dev/null | grep -E '^VERSION_ID=' | cut -d'=' -f2 | tr -d '\"' || echo '24.04')"
cat > /usr/lib/os-release <<OSR
PRETTY_NAME="WX OS 1.0"
NAME="WX OS"
VERSION_ID="1.0"
VERSION="1.0 (base Ubuntu ${UBUVER} LTS)"
VERSION_CODENAME=noble
ID=wxos
ID_LIKE="ubuntu debian"
HOME_URL="https://souzasolucoesdigitais.com.br"
SUPPORT_URL="https://souzasolucoesdigitais.com.br"
BUG_REPORT_URL="https://souzasolucoesdigitais.com.br"
LOGO=wx-os
VENDOR_NAME="GR TECH"
OSR
ln -sf ../usr/lib/os-release /etc/os-release
printf '%s\n' 'WX OS 1.0 \n \l' > /etc/issue
echo "WX OS 1.0" > /etc/issue.net

# ---- Idioma, teclado ABNT2 e fuso ----
sed -i 's/^# *pt_BR.UTF-8 UTF-8/pt_BR.UTF-8 UTF-8/' /etc/locale.gen
grep -q '^pt_BR.UTF-8 UTF-8' /etc/locale.gen || echo 'pt_BR.UTF-8 UTF-8' >> /etc/locale.gen
locale-gen
update-locale LANG=pt_BR.UTF-8 LANGUAGE=pt_BR:pt:en
cat > /etc/default/keyboard <<KBD
XKBMODEL="abnt2"
XKBLAYOUT="br"
XKBVARIANT=""
XKBOPTIONS=""
BACKSPACE="guess"
KBD
ln -sf /usr/share/zoneinfo/America/Sao_Paulo /etc/localtime
echo "America/Sao_Paulo" > /etc/timezone

# ---- Instalador Calamares com a marca WX OS ----
if [ -f /etc/calamares/settings.conf ]; then
  sed -i 's/^branding:.*/branding: wxos/' /etc/calamares/settings.conf
fi
for f in /usr/share/applications/install-debian.desktop /usr/share/applications/calamares.desktop /usr/share/applications/io.calamares.calamares.desktop; do
  [ -f "$f" ] || continue
  sed -i -e 's/^Name=.*/Name=Instalar o WX OS/' \
         -e 's/^Name\[pt_BR\]=.*/Name[pt_BR]=Instalar o WX OS/' \
         -e 's/^Icon=.*/Icon=\/usr\/share\/pixmaps\/wx-os.png/' "$f"
done

# Instalação do GRUB sem precisar de internet: deixa os pacotes guardados na ISO
baixar_grub() {
  dir="/opt/wxos/grub/$1"; shift
  mkdir -p "$dir/partial"
  apt-get install -y --download-only --no-install-recommends \
    -o Dir::Cache::archives="$dir" "$@" || echo "aviso: não baixou $*"
  rm -rf "$dir/partial" "$dir/lock"
}
baixar_grub efi grub-efi-amd64 grub-efi-amd64-signed shim-signed
baixar_grub bios grub-pc
# Substitui TODOS os scripts de bootloader do Calamares (Debian e Ubuntu) pelo do WX OS
for alvo in /usr/sbin/bootloader-config \
            /usr/share/calamares/helpers/calamares-bootloader-config \
            $(find /usr/share/calamares /usr/lib/calamares /usr/libexec -name '*bootloader-config*' -type f 2>/dev/null); do
  [ "$alvo" = /usr/local/sbin/wxos-bootloader-config ] && continue
  if [ -e "$alvo" ] && [ ! -L "$alvo" ] && ! dpkg-divert --list "$alvo" | grep -q wxos; then
    dpkg-divert --local --package wxos --rename --divert "$alvo.ubuntu" --add "$alvo"
  fi
  mkdir -p "$(dirname "$alvo")"
  ln -sf /usr/local/sbin/wxos-bootloader-config "$alvo"
done

# ---- Loja: repositório Flathub no Discover (LibreOffice e outros apps) ----
if command -v flatpak >/dev/null 2>&1; then
  flatpak remote-add --system --if-not-exists flathub \
    https://dl.flathub.org/repo/flathub.flatpakrepo || echo "aviso: Flathub não adicionado"
fi

# ---- Ícones estilo macOS Squircle (WhiteSur) ----
mkdir -p /usr/share/icons
echo ">>> [WX OS] Baixando pacote de ícones WhiteSur (macOS Big Sur squircle)..."
curl -fsSL "https://github.com/vinceliuice/WhiteSur-icon-theme/releases/latest/download/WhiteSur-dark.tar.xz" -o /tmp/whitesur-dark.tar.xz && \
  tar -xf /tmp/whitesur-dark.tar.xz -C /usr/share/icons/ && \
  rm -f /tmp/whitesur-dark.tar.xz || echo "aviso: WhiteSur icon theme não baixado, mantendo Papirus como fallback"

# ---- Atualizar cache de fontes e permissões ----
# ---- Papéis de parede e telas de login (links para não duplicar arquivos) ----
mkdir -p /usr/share/backgrounds /usr/share/sddm/themes/breeze
ln -sf /usr/share/wallpapers/WXOS/contents/images/1920x1080.png /usr/share/backgrounds/distro-wallpaper.png
ln -sf /usr/share/wallpapers/WXOS/contents/images/1920x1080.png /usr/share/sddm/themes/breeze/wxos-fundo.png

fc-cache -f 2>/dev/null || true
chmod 755 /usr/local/bin/wxos-* /usr/local/sbin/wxos-* 2>/dev/null || true
[ -f /etc/profile.d/wxos-env.sh ] && chmod 755 /etc/profile.d/wxos-env.sh

# ---- ISO leve: remove idiomas extras, manuais e documentação ----
# (o arquivo /etc/dpkg/dpkg.cfg.d/01-wxos-leve já impede que voltem)
for d in /usr/share/locale /usr/share/help; do
  [ -d "$d" ] || continue
  find "$d" -mindepth 1 -maxdepth 1 -type d \
    ! -name 'pt' ! -name 'pt_BR' ! -name 'en' ! -name 'en_US' ! -name 'en_GB' ! -name 'C' \
    -exec rm -rf {} +
done
rm -rf /usr/share/man/* /usr/share/info/* /usr/share/lintian/* /usr/share/linda/*
find /usr/share/doc -mindepth 1 ! -type d ! -name copyright -delete 2>/dev/null || true
find /usr/share/doc -mindepth 1 -type d -empty -delete 2>/dev/null || true
apt-get clean
rm -f /var/cache/apt/*.bin

echo ">>> [WX OS] personalização e interface estilo macOS concluídas"
