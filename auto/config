#!/bin/sh
# Configuração do live-build do WX OS (base Ubuntu 24.04 LTS "noble")
set -e

lb config noauto \
  --mode ubuntu \
  --distribution noble \
  --architectures amd64 \
  --archive-areas "main restricted universe multiverse" \
  --parent-mirror-bootstrap "http://archive.ubuntu.com/ubuntu/" \
  --parent-mirror-chroot "http://archive.ubuntu.com/ubuntu/" \
  --parent-mirror-binary "http://archive.ubuntu.com/ubuntu/" \
  --mirror-bootstrap "http://archive.ubuntu.com/ubuntu/" \
  --mirror-chroot "http://archive.ubuntu.com/ubuntu/" \
  --mirror-binary "http://archive.ubuntu.com/ubuntu/" \
  --security true \
  --updates true \
  --debian-installer none \
  --firmware-chroot false \
  --firmware-binary false \
  --binary-images iso-hybrid \
  --bootloaders "grub-efi" \
  --image-name "wx-os" \
  --iso-application "WX OS" \
  --iso-volume "WX_OS" \
  --iso-publisher "GR TECH" \
  --bootappend-live "boot=casper quiet splash locales=pt_BR.UTF-8 keyboard-layouts=br keyboard-model=abnt2 timezone=America/Sao_Paulo username=wxos hostname=wx-os" \
  --memtest none \
  --cache-packages false \
  --chroot-squashfs-compression-type xz \
  "${@}"
