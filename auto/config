#!/bin/sh
# Configuração do live-build do WX OS (base Debian 13 "trixie")
set -e

lb config noauto \
  --mode debian \
  --distribution trixie \
  --architectures amd64 \
  --archive-areas "main contrib non-free non-free-firmware" \
  --mirror-bootstrap "http://deb.debian.org/debian/" \
  --mirror-chroot "http://deb.debian.org/debian/" \
  --mirror-binary "http://deb.debian.org/debian/" \
  --security true \
  --updates true \
  --debian-installer none \
  --firmware-chroot false \
  --firmware-binary false \
  --binary-images iso-hybrid \
  --bootloaders "grub-efi syslinux" \
  --image-name "wx-os" \
  --iso-application "WX OS" \
  --iso-volume "WX_OS" \
  --iso-publisher "GR TECH" \
  --bootappend-live "boot=live components quiet splash locales=pt_BR.UTF-8 keyboard-layouts=br keyboard-model=abnt2 timezone=America/Sao_Paulo username=wxos hostname=wx-os" \
  --memtest none \
  --cache-packages false \
  --chroot-squashfs-compression-type xz \
  "${@}"
